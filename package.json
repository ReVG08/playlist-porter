{
  "name": "playlist-porter",
  "version": "1.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Local-first Spotify and TIDAL playlist transfer",
  "author": "ReVG08 and contributors",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch src/server/index.ts\"",
    "desktop:dev": "npm run build && npm run desktop:bundle && electron .",
    "build": "tsc -b && vite build",
    "desktop:bundle": "esbuild src/desktop/main.ts --bundle --platform=node --format=cjs --outfile=dist/desktop/main.cjs --external:electron",
    "desktop:package": "npm run build && npm run desktop:bundle && electron-builder --dir",
    "desktop:mac": "npm run build && npm run desktop:bundle && electron-builder --mac dmg zip",
    "desktop:win": "npm run build && npm run desktop:bundle && electron-builder --win nsis portable",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "test": "vitest run --root .",
    "test:watch": "vitest --root .",
    "typecheck": "tsc -b",
    "lint": "eslint ."
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "@eslint/js": "^9.35.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.2.1",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.9",
    "express": "^5.1.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "engines": { "node": ">=20" },
  "main": "dist/desktop/main.cjs",
  "build": {
    "appId": "com.playlistporter.app",
    "productName": "Playlist Porter",
    "asar": true,
    "files": ["dist/**/*", "package.json", "LICENSE", "README.md"],
    "directories": { "output": "release", "buildResources": "build" },
    "artifactName": "Playlist-Porter-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.music",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }, { "target": "zip", "arch": ["arm64", "x64"] }],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": { "title": "Playlist Porter ${version}", "iconSize": 112, "contents": [{ "x": 170, "y": 190 }, { "x": 430, "y": 190, "type": "link", "path": "/Applications" }] },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": { "artifactName": "Playlist-Porter-${version}-Windows-${arch}-Setup.${ext}", "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true },
    "portable": { "artifactName": "Playlist-Porter-${version}-Windows-${arch}-Portable.${ext}" }
  }
}
